# ---------- required ----------
# Free, 20k requests/month. https://rawg.io/apidocs
RAWG_KEY=

# ---------- strongly recommended ----------
# Free. Portrait 600x900 cover art, much better fit than RAWG's 16:9 header.
# https://www.steamgriddb.com/profile/preferences/api
SGDB_KEY=

# ---------- language model (OpenRouter) ----------
# https://openrouter.ai/keys  — :free models, 20 req/min, 50 req/day
# (1,000/day after a one-time $10 credit purchase).
# Run `npm run models` to see which free models exist today and which take images.
OPENROUTER_KEY=
OPENROUTER_TEXT_MODEL=openrouter/free
OPENROUTER_VISION_MODEL=openrouter/free

# ---------- cover styling (all optional — every one has a working default) ----------
# Printed bottom-right on the front, on the spine, and next to the credit line on the
# back — where a publisher logo would sit on a retail case. Your initials/monogram.
COVER_MARK=
# Band + bullet-accent colour across every cover on the shelf. Hex, e.g. #1B3A93.
COVER_ACCENT=
# Two lines max, printed next to the rating box on the back panel. Node's --env-file
# loader does NOT turn a literal \n into a newline — use a quoted value with a real
# line break inside it, exactly like this, or leave unset for the default below.
COVER_ADDRESS="Personal archive copy
Printed at home"
# auto = PS4 games get the PS4 look (accent band, black block), PS5 games get the PS5
# look (white band, white block). Set to ps4 or ps5 to force one look for every cover.
COVER_LAYOUT=auto
# The line under the title on the front panel. Same for every cover unless you change it.
COVER_EDITION=Standard Edition

# ---------- behaviour ----------
VISION_REVIEW=true
AUTO_THRESHOLD=70
BLEED_MM=3
