# ---------- required ----------
# Free, 20k requests/month. https://rawg.io/apidocs
RAWG_KEY=

# ---------- strongly recommended ----------
# Free. Portrait 600x900 cover art, much better fit than RAWG's 16:9 header.
# https://www.steamgriddb.com/profile/preferences/api
SGDB_KEY=

# ---------- language model ----------
# https://openrouter.ai/keys  — :free models, 20 req/min, 50 req/day
# (1,000/day after a one-time $10 credit purchase).
# Run `npm run models` to see which free models exist today and which take images.
OPENROUTER_KEY=
OPENROUTER_TEXT_MODEL=openrouter/free
OPENROUTER_VISION_MODEL=openrouter/free

# ---------- behaviour ----------
VISION_REVIEW=true
AUTO_THRESHOLD=70
BLEED_MM=3
