# ENV

# ---------- web app (npm run dev / npm start) ----------
# Bind and origin. Set APP_ORIGIN to the public origin in production so cookies are
# marked Secure and cross-origin form posts are compared against it.
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=
# 32+ random bytes. Seals provider keys with AES-256-GCM. Leave blank in development
# and the app generates data/secret.key (mode 0600) on first run.
APP_SECRET=
# Where SQLite, uploads and renders live. Back this directory up.
DATA_DIR=
DB_FILE=
# Set to true only when the app is served over HTTPS.
COOKIE_SECURE=false
# Shown on /legal as the takedown contact. Optional.
LEGAL_CONTACT=

# ---------- provider keys (web app + CLI) ----------
# Keys are read from this file only. The browser has no key-entry form; edit .env
# and restart the server for changes to take effect. Never commit this file.
# Free, 20k requests/month. https://rawg.io/apidocs
RAWG_KEY=
# Free. Portrait 600x900 cover art, much better fit than RAWG's 16:9 header.
# PERSONAL, NON-COMMERCIAL USE ONLY (SteamGridDB's terms). Used by the CLI and, when
# set, by the local web app's art picker. Leave unset in any hosted or paid deployment.
# https://www.steamgriddb.com/profile/preferences/api
SGDB_KEY=
# ---------- language model (web app + CLI) ----------
# Local, no key, no quota: `ollama pull llama3.2` and `ollama pull llava`.
# Ollama is the only language model. llama3.2 writes back-cover copy and AI-art
# prompts; llava reviews each rendered front (set VISION_REVIEW=false to skip).
# When Ollama is down, copy falls back to the RAWG description.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=llama3.2
OLLAMA_VISION_MODEL=llava

# ---------- cover styling (CLI only — the web app sets this per project) ----------
# Printed bottom-right on the front, on the spine, and next to the credit line on the
# back — where a publisher logo would sit on a retail case. Your initials/monogram.
COVER_MARK=
# Band + bullet-accent colour across every cover on the shelf. Hex, e.g. #1B3A93.
COVER_ACCENT=
# Two lines max, printed next to the rating box on the back panel. Node's --env-file
# loader does NOT turn a literal \n into a newline — use a quoted value with a real
# line break inside it, exactly like this, or leave unset for the default below.
COVER_ADDRESS="Personal archive copy
Printed at home"
# auto = PS4 games get the PS4 look (accent band, black block), PS5 games get the PS5
# look (white band, white block). Set to ps4 or ps5 to force one look for every cover.
COVER_LAYOUT=auto
# The line under the title on the front panel.
COVER_EDITION=Standard Edition

# ---------- behaviour ----------
VISION_REVIEW=true
AUTO_THRESHOLD=70
BLEED_MM=3
