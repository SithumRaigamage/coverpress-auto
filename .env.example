# ---------- required ----------
# Free, 20k requests/month. https://rawg.io/apidocs
RAWG_KEY=

# ---------- strongly recommended ----------
# Free. Portrait 600x900 cover art, much better fit than RAWG's 16:9 header.
# https://www.steamgriddb.com/profile/preferences/api
SGDB_KEY=

# ---------- language model: pick ONE ----------
# openrouter | gemini   (defaults to openrouter if OPENROUTER_KEY is set)
LLM_PROVIDER=openrouter

# https://openrouter.ai/keys  — :free models, 20 req/min, 50 req/day
# (1,000/day after a one-time $10 credit purchase).
# Run `npm run models` to see which free models exist today and which take images.
OPENROUTER_KEY=
OPENROUTER_TEXT_MODEL=deepseek/deepseek-chat-v3.1:free
OPENROUTER_VISION_MODEL=qwen/qwen2.5-vl-72b-instruct:free

# Alternative: https://aistudio.google.com/apikey — free Flash tier, 10 req/min.
GEMINI_KEY=
GEMINI_MODEL=gemini-3-flash

# ---------- behaviour ----------
VISION_REVIEW=true
AUTO_THRESHOLD=70
BLEED_MM=3
