{
  "name": "coverpress-auto",
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=20.6" },
  "scripts": {
    "smoke": "node smoke.mjs",
    "build": "node --env-file=.env pipeline.mjs build",
    "rebuild": "node --env-file=.env pipeline.mjs build --force",
    "review": "node --env-file=.env pipeline.mjs review",
    "print": "node --env-file=.env pipeline.mjs print",
    "prompts": "node --env-file=.env pipeline.mjs prompts",
    "models": "node --env-file=.env pipeline.mjs models"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.60"
  }
}
