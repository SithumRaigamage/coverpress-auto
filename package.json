{
  "name": "coverpress",
  "version": "2.0.0",
  "type": "module",
  "description": "Print-ready PS4/PS5 case inserts for digital games — web app and local batch CLI.",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --env-file=.env server/index.mjs",
    "dev:web": "npm --prefix frontend run dev",
    "api": "node server/index.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node --test tests",
    "smoke": "node smoke.mjs",
    "build": "node --env-file=.env pipeline.mjs build",
    "rebuild": "node --env-file=.env pipeline.mjs build --force",
    "print": "node --env-file=.env pipeline.mjs print",
    "prompts": "node --env-file=.env pipeline.mjs prompts",
    "models": "node --env-file=.env pipeline.mjs models",
    "plan": "node --env-file=.env server/cli.mjs plan",
    "usage": "node --env-file=.env server/cli.mjs usage"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.60"
  }
}
